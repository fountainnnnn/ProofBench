{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.railway",
    "watchPatterns": [
      "engine/**",
      "server/**",
      "web/**",
      "requirements.in",
      "requirements.txt",
      "Dockerfile.railway",
      "railway.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/api/deploy-ready",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "overlapSeconds": "0",
    "drainingSeconds": "45"
  }
}

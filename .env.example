# ProofBench environment — copy to `.env` and fill in the values.
# Loaded via python-dotenv at entry points only (server/main.py, smoke_test.py).
# NEVER commit .env and never print these values in logs.

# --- ProofBench access control ----------------------------------------------
# Choose exactly ONE profile. The API refuses to start if neither is set.
#
# 1. LOCAL (the default supported shape): one operator, Compose bound to
#    127.0.0.1, no API token anywhere. Every request resolves to the single
#    deterministic tenant below, and the console signs itself in.
#    LOOPBACK ONLY. This profile has no authentication at all: anything that
#    can reach the listener has full read and write access to your benchmark
#    data. Do not port-forward it, publish it on a LAN or 0.0.0.0 address, or
#    put it behind a public ingress. To expose it, switch to profile 2.
PROOFBENCH_INSECURE_DEV=1
PROOFBENCH_DEV_TENANT=local-dev
# JSON map of tenant ids to long random bearer tokens. Leave EMPTY in profile 1.
PROOFBENCH_API_KEYS=
#
# 2. AUTHENTICATED (any deployment reachable by anyone but you): set
#    PROOFBENCH_INSECURE_DEV=0 and give PROOFBENCH_API_KEYS a JSON map of at
#    least 32 random characters per token. Clients then send
#    `Authorization: Bearer <token>` and the console shows a sign-in gate.
#    Generate a token with a password manager or:
#      python -c "import secrets; print(secrets.token_urlsafe(32))"
#    e.g. PROOFBENCH_API_KEYS={"acme":"<32+ random characters>"}

# Comma-separated browser origins allowed to call the API directly. Same-origin
# deployments behind the included Nginx proxy do not require broad CORS.
PROOFBENCH_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Browser auth cookie issued after POST /api/auth/session. Use `true` behind
# HTTPS; `auto` honors the request and forwarded protocol.
PROOFBENCH_COOKIE_SECURE=auto
PROOFBENCH_COOKIE_MAX_AGE=28800

# Durable state, tenant quotas, and retention.
# PROOFBENCH_STATE_DB=runs/proofbench.sqlite3
# Railway/PostgreSQL: set this to a Railway reference variable such as
# ${{Postgres.DATABASE_URL}} in the dashboard. It takes precedence over SQLite.
# PROOFBENCH_DATABASE_URL=
# Railway's combined image prepares these below /app/runtime automatically.
# PROOFBENCH_RUNS_ROOT=/app/runtime/runs
# PROOFBENCH_DATASET_ROOT=data/uploads
PROOFBENCH_MAX_CONCURRENT_RUNS_PER_TENANT=2
PROOFBENCH_RUNS_PER_DAY=100
PROOFBENCH_MAX_CONCURRENT_CHATS_PER_TENANT=4
PROOFBENCH_CHATS_PER_DAY=500
PROOFBENCH_REQUESTS_PER_MINUTE=600
# Automatic expiry of COMPLETED tenant data, in days.
#   0  = no automatic expiry (the default for this local, solo-operated setup).
#        Nothing you create is deleted on a timer; you delete sessions and
#        datasets yourself, and those explicit deletions still run normally.
#   1..3650 = expire completed sessions, runs, and unreferenced datasets after
#        that many days. Active runs are never expired at any setting.
# Set a positive value only if you actually want data to disappear on its own.
PROOFBENCH_RETENTION_DAYS=0
# The one-client Railway trial runbook uses an explicitly disclosed finite
# value (example: 7), not the local no-expiry default.
PROOFBENCH_MAX_TENANT_DATASET_BYTES=1073741824
PROOFBENCH_MAX_EVENTS=1000
PROOFBENCH_MAX_MESSAGES=200
PROOFBENCH_MAX_MESSAGE_CHARS=12000
PROOFBENCH_MAX_EVENT_CHARS=12000
PROOFBENCH_MAX_EVENT_BYTES=65536

# Crash recovery only touches Daytona sandboxes recorded in this deployment's
# ownership ledger. Keep the deployment id stable across restarts, or the ledger
# loses track of what it owns and leaked sandboxes are never reclaimed.
# Despite the name this reconciler runs at startup AND every ten minutes, because
# a run killed mid-flight leaves sandboxes that keep consuming the account's
# memory budget until something deletes them. Leave it on.
PROOFBENCH_RECONCILE_SANDBOXES_ON_STARTUP=1
PROOFBENCH_DEPLOYMENT_ID=proofbench-local
PROOFBENCH_JOB_LEASE_SECONDS=90
PROOFBENCH_ORPHAN_GRACE_SECONDS=120
PROOFBENCH_MIGRATION_BACKUP=1
# PROOFBENCH_SANDBOX_LEDGER=runs/sandbox_ledger.sqlite3
# PROOFBENCH_WORKER_ID is normally generated uniquely at process start.

# Provider base URLs are restricted to known hosts plus this optional
# comma-separated list.
PROOFBENCH_ALLOW_PROVIDER_NONSTANDARD_PORTS=0
# PROOFBENCH_PROVIDER_HOST_ALLOWLIST=api.vendor.example,*.trusted.vendor.example

# Upload/resource ceilings. Defaults shown.
PROOFBENCH_MAX_UPLOAD_IMAGES=100
PROOFBENCH_MAX_IMAGE_BYTES=10485760
PROOFBENCH_MAX_UPLOAD_BYTES=104857600
PROOFBENCH_MAX_CSV_BYTES=2097152
PROOFBENCH_MAX_IMAGE_PIXELS=40000000

# --- Daytona (sandbox fleet) -------------------------------------------------
# API key from https://app.daytona.io — read by the `daytona` SDK from the
# environment (engine/sandbox_pool.py); also required by smoke_test.py.
DAYTONA_API_KEY=
# Optional SDK overrides (defaults shown):
# DAYTONA_API_URL=https://app.daytona.io/api
# The region MUST be one your organization is entitled to for container-class
# sandboxes. A wrong region reports "Declarative builds are not available to
# your organization in region <x>", which misdescribes the cause; the real
# message is "Region <x> is not available to the organization for class
# container". Check this first when every sandbox creation fails.
# DAYTONA_TARGET=us
# Keep the sandbox interpreter compatible with binary OCR wheels.
# DAYTONA_SANDBOX_IMAGE=python:3.12-slim
#
# Providers meter total CONCURRENT sandbox memory per account, and a sandbox
# that is stopped but not deleted still counts against it. Declare the tier's
# budget and the pool never asks for more than it allows: excess candidates wait
# for a peer to finish instead of being refused. 0 (the default) disables the
# cap and restores the previous ask-and-be-refused behaviour.
# See README "Sandbox capacity and cleanup".
PROOFBENCH_SANDBOX_MEMORY_BUDGET_GIB=0
# Per-sandbox shape. 4 GiB is the supported baseline (EasyOCR's detector is
# killed below it); raise only to a shape your account actually offers.
# PROOFBENCH_SANDBOX_MEMORY_GIB=4
# PROOFBENCH_SANDBOX_CPU=2


# --- Orchestrator ------------------------------------------------------------
# LLM work is capability based. Each capability lists the providers that can
# serve it, most preferred first; the first one you have configured is used:
#
#   orchestration  MOONSHOT -> OPENAI -> OPENROUTER   (required to run)
#   report         MOONSHOT -> OPENAI -> OPENROUTER
#   assessment     DOUBLEWORD -> OPENROUTER -> OPENAI -> DEEPSEEK
#   codegen        DEEPSEEK -> OPENROUTER
#
# OpenRouter appears in every list, so OPENROUTER_API_KEY alone is enough to run
# ProofBench without OpenAI, DeepSeek, or Doubleword. GET /api/providers reports
# which provider each capability resolved to, from configuration only.
#
# `auto` follows the order above. Set explicitly to `openai`, `moonshot`/`kimi`,
# or `openrouter` to pin orchestration and report writing to one provider.
ORCHESTRATOR_PROVIDER=auto

# Independent supervision. A supervisor is the DISTINCT (provider, model) that
# corrects a checkpoint where the primary model would otherwise review its own
# output — the intake spec recovery, the shortlist elimination, and the
# assessment self-check. The same model grading its own answer carries the
# correlated bias and laziness that make the check worthless, so supervision only
# ever runs on a model identity different from the primary producer.
#
# Resolution: with neither set, a supervisor is the first configured provider (in
# the fixed supervision order) whose identity differs from the primary — so a
# two-provider deployment supervises automatically. Pin the reviewer's provider
# with SUPERVISOR_PROVIDER (openai / moonshot|kimi / openrouter / deepseek /
# doubleword). Give the reviewer a specific model with SUPERVISOR_MODEL; this is
# also the ONLY way the same provider may supervise — the model must genuinely
# differ from the primary's, or resolution yields no supervisor rather than fake
# an independent review. SUPERVISOR_MODEL without SUPERVISOR_PROVIDER is applied
# only to the primary provider (a model id belongs to one API); to run it on a
# different provider, pin that provider too. When none can be resolved, single-provider deployments
# keep working: the correction is skipped honestly and the contradiction is
# published as a caveat, never silently re-asked of the same identity.
# SUPERVISOR_PROVIDER=
# SUPERVISOR_MODEL=

# OpenAI orchestrator fallback and OpenAI Vision candidate.
OPENAI_API_KEY=
OPENAI_ORCHESTRATOR_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o
# Optional; defaults to OPENAI_ORCHESTRATOR_MODEL.
# OPENAI_REPORT_MODEL=gpt-4o

# Compose binds the web listener to loopback so only a same-host TLS ingress can
# reach it. Change deliberately only when a trusted network boundary exists.
PROOFBENCH_BIND_ADDRESS=127.0.0.1
PROOFBENCH_BIND_PORT=8080
# Optional pre-built image references. No images are published: pushing a tag
# does nothing, and the manual release workflow is intentionally blocked until
# the LICENSE legal name, a reviewed THIRD_PARTY_NOTICES.md, and the operator's
# distribution-checklist acknowledgement are all satisfied. Leave these unset
# and Compose builds from source, which is the supported path today. Set them
# only to an immutable digest you built and pushed yourself.
# PROOFBENCH_API_IMAGE=ghcr.io/operator/proofbench-api@sha256:...
# PROOFBENCH_WEB_IMAGE=ghcr.io/operator/proofbench-web@sha256:...
PROOFBENCH_API_MEMORY_LIMIT=2g
PROOFBENCH_API_CPU_LIMIT=2.0
PROOFBENCH_WEB_MEMORY_LIMIT=256m
PROOFBENCH_WEB_CPU_LIMIT=0.5

# Optional Kimi / Moonshot orchestrator + report writer.
# Moonshot is OpenAI-compatible at https://api.moonshot.ai/v1.
MOONSHOT_API_KEY=
# Orchestrator model. Default is kimi-k2-thinking; override if /v1/models
# shows a different name on your account.
KIMI_MODEL=kimi-k2-thinking

# Optional MiniMax orchestrator / assessor / report writer.
# MiniMax is OpenAI-compatible at https://api.minimax.io/v1. It has its own
# slot rather than being driven through OPENAI_*: readiness, run provenance and
# the supervisor's distinct-reviewer rule identify a provider by slot, so a
# MiniMax run configured as OpenAI would report the wrong vendor and could be
# selected as its own independent reviewer.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3

# --- Oxylabs (docs intelligence: web search + page scrape) -------------------
# HTTP basic auth for https://realtime.oxylabs.io/v1/queries
# (engine/docs_intel.py — google_search + universal scrape).
OXYLABS_USERNAME=
OXYLABS_PASSWORD=

# --- Scrape.do (docs intelligence: web search + page scrape) -----------------
# One token serves both capabilities. When configured, Scrape.do leads the
# default provider chain because it is the fastest measured path.
SCRAPEDO_API_TOKEN=

# --- Bright Data (docs intelligence fallback) --------------------------------
# Create two zones in the Bright Data console — one SERP API, one Web Unlocker —
# and name them here.
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_SERP_ZONE=
BRIGHTDATA_UNLOCKER_ZONE=

# Ordered search/scrape chain. Missing providers are appended as fallbacks;
# providers without credentials are skipped.
PROOFBENCH_SCRAPER_ORDER=scrapedo,oxylabs,brightdata

# --- Nosana (GPU-hosted VLM candidate, OpenAI-compatible) --------------------
# All three are required to run the `nosana_vlm` candidate. The values are
# passed through into the Daytona sandbox, where the adapter reads them via
# os.environ (engine/candidates/fallbacks/nosana_vlm.py).
NOSANA_API_KEY=
# OpenAI-compatible base URL of your Nosana deployment, e.g.
# https://<your-nosana-endpoint>/v1
NOSANA_BASE_URL=
# Model name served at that endpoint.
NOSANA_MODEL=

# --- Doubleword (Real-mode batched assessments + hosted candidate) -----------
# Used by the Real-mode documentation assessment batch and by the `doubleword`
# candidate fallback.
DOUBLEWORD_API_KEY=
# Model for Real-mode batched documentation assessments. Pick one from
# https://api.doubleword.ai/v1/models.
DOUBLEWORD_MODEL=
# Optional override (default https://api.doubleword.ai/v1):
# DOUBLEWORD_BASE_URL=https://api.doubleword.ai/v1
# Assessments always use concurrent synchronous completions, never a batch
# queue: the queue trades latency for throughput and a run pays that latency
# while a person waits (measured 257s queued against 4.3s concurrent).

# --- DeepSeek (primary adapter code generation + repair) ---------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# --- OpenRouter (OpenAI-compatible fallback for every LLM capability) --------
# One key covers orchestration, documentation assessment, report writing, and
# adapter generation, so a deployment can run on OpenRouter alone.
OPENROUTER_API_KEY=
# Model slug from https://openrouter.ai/models. Default: openai/gpt-4o-mini.
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional override. Defaults to https://openrouter.ai/api/v1, must be a public
# HTTPS host on port 443, and is checked against the provider host allowlist.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#
# These are orchestration credentials. Like DAYTONA_, OXYLABS_, DEEPSEEK_, and
# the other orchestration prefixes, OPENROUTER_ is permanently forbidden inside
# candidate and verification sandboxes; no generated adapter can be granted it.

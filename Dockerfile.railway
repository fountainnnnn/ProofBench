FROM node:22.23.1-alpine3.24@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2 AS web-build

WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web ./
RUN npm run build

FROM python:3.12-alpine3.23@sha256:601d3d3797e90e2534782e69c85fafb7971b43f24c7b1b079b7e48dd435e458d

LABEL org.opencontainers.image.title="proofbench-railway" \
      org.opencontainers.image.licenses="LicenseRef-Proprietary" \
      org.opencontainers.image.description="ProofBench single-service Railway client-trial image."

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PROOFBENCH_WEB_ROOT=/app/web-dist

WORKDIR /app
COPY requirements.txt ./
RUN python -m pip install --no-cache-dir --require-hashes -r requirements.txt

COPY engine ./engine
COPY server ./server
COPY make_dataset.py ./
COPY --from=web-build /web/dist ./web-dist

RUN addgroup -S -g 10001 proofbench \
    && adduser -S -D -u 10001 -G proofbench -h /app proofbench \
    && mkdir -p /app/runtime/runs /app/runtime/data/uploads \
    && chown -R proofbench:proofbench /app

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=5 \
  CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.environ.get('PORT','8000')+'/api/deploy-ready',timeout=3)" || exit 1

# Railway volumes are mounted root-owned. This tiny entrypoint prepares only
# the dedicated runtime mount, then drops permanently to uid/gid 10001 before
# importing or serving the application.
CMD ["python", "-m", "server.railway_entrypoint"]
